# Google OAuth (OpenID Connect) — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 48
# Must be at least 32 characters.
SESSION_SECRET=

# Google Workspace domain allowed to sign in. Only verified accounts on this
# hosted domain can reach the internal docs.
ALLOWED_HOSTED_DOMAIN=equature.com
